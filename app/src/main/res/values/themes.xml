<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Southbound" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches the light map background so launch has no white flash. -->
        <item name="android:windowBackground">@color/map_background</item>
        <!-- The splash has its own icon. Without these items Android 12+ falls back to the launcher icon on
             the window background, so editing the launcher icon would change the splash. Background: what
             the fallback used (the window background). Icon background: set only so the system doesn't
             enlarge the icon 1.2x, as it does an icon with no background; an adaptive icon draws its own. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">@color/map_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
