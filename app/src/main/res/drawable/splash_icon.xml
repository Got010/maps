<?xml version="1.0" encoding="utf-8"?>
<!-- The splash screen's icon (windowSplashScreenAnimatedIcon in themes.xml). It is the launcher icon as it
     was before the launcher icon was scaled down: the same blue background and fin, as an adaptive icon so
     Android draws it the way it drew the launcher icon when the splash fell back to it. The launcher icon
     (mipmap/ic_launcher) can now change without changing the splash. No monochrome layer: the splash
     never themes it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/splash_icon_foreground" />
</adaptive-icon>
