<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone except Settings > Backup > Export, started by hand.
     allowBackup="false" alone does not stop device-to-device transfer at targetSdk 31+,
     so both channels exclude every domain the app uses. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
