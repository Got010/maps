    <string name="updates_packs">Download map data</string>
    <string name="updates_packs_note">Maps, search, directions and transit data from Southbound\'s GitHub releases, checked daily. Only the files that changed are downloaded, and each is checked against its published SHA-256.</string>
    <string name="updates_app">Install app updates</string>
    <string name="updates_app_note">New versions of Southbound from the same releases, checked to be signed with the same key. Android asks you to confirm the first one; after that Southbound updates itself.</string>
