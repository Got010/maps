    <string name="settings_about">About</string>
    <string name="settings_about_body">Southbound keeps maps, search, routing and voice on your phone. Map data © OpenStreetMap contributors (ODbL), shown with the OpenMapTiles schema (© OpenMapTiles). Routing by Valhalla; navigation by Ferrostar (Stadia Maps); map rendering by MapLibre. Built-in voice: Piper \"Amy\" (Mycroft mimic3-voices) run by sherpa-onnx.</string>
    <string name="settings_live">Live data</string>
    <string name="settings_live_note">Everything above works offline. These extras go online only when turned on, and fetch whole feeds, so nothing sent says where you are, what you searched or where you\'re going.</string>
    <string name="live_transit">Live subway, LIRR and Metro-North</string>
    <string name="live_transit_note">Arrival times and service alerts from MTA. No key needed.</string>
    <string name="live_bus">Live buses (MTA Bus Time)</string>
    <string name="live_bus_note">Needs a free key from bustime.mta.info. Stored encrypted on this phone.</string>
