<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the car host show the navigation template (turn, distance, arrival). -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <application>
        <!-- Android Auto reads this key to find the app's car description. It is only a manifest
             name the host looks for; no Google Play Services library is involved. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Templates only (API level 1); the map surface (level 2) is a follow-up. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Exported so the car host can bind it; the library's HostValidator checks who binds. -->
        <service
            android:name="app.southbound.feature.car.SouthboundCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>
</manifest>
